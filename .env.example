# Raspberry Pi dashboard (default binds to Pi localhost)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
SERVER_NAME="Home Server"
REFRESH_SECONDS=5
ROTATE_SECONDS=12

# Optional remote metrics: install agent.py on Ubuntu Server and use private networking.
REMOTE_AGENT_URL=
REMOTE_AGENT_TOKEN=

# Optional TCP service checks. Empty is valid.
SERVICES_JSON='[]'

# On the remote server ONLY, when running agent.py:
# AGENT_TOKEN=replace-with-a-long-random-token
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8766
