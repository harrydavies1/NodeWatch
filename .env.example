# NodeWatch settings on the Raspberry Pi. Copy to .env and keep .env local.

# PI MODE (default): leave REMOTE_AGENT_URL empty. Reads real Pi stats.
# SERVER MODE: run agent.py on Ubuntu/Linux Server, then set:
# REMOTE_AGENT_URL=http://YOUR_SERVER_LAN_IP:8766
# REMOTE_AGENT_TOKEN=THE_SAME_VALUE_AS_SERVER_AGENT_TOKEN
SERVER_NAME="Raspberry Pi"
REMOTE_AGENT_URL=
REMOTE_AGENT_TOKEN=

# Tkinter dashboard timing (configured on Raspberry Pi only)
REFRESH_SECONDS=5
AUTO_ROTATE_PAGES=true
# Interval when AUTO_ROTATE_PAGES=true; ignored when disabled.
ROTATE_SECONDS=12

# Optional TCP reachability checks
SERVICES_JSON='[]'

# On the Ubuntu/Linux server's .env ONLY (optional remote metrics agent):
# AGENT_TOKEN=replace-with-a-long-random-token
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8766
# Legacy single-drive option (Ubuntu Server only):
# NAS_STORAGE_PATH=/srv/nas/drive1
# Optional two-drive monitor (Ubuntu Server only; adds a NAS page to the Pi):
# NAS_STORAGE_PATHS='[{"name":"NAS Drive 1","path":"/srv/nas/drive1"},{"name":"NAS Drive 2","path":"/srv/nas/drive2"}]'
