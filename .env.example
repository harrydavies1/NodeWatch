# NodeWatch configuration on the Raspberry Pi.
# Copy to .env. Never commit the real .env (especially tokens).

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Monitoring Method 1: PI MODE (the default)
# Leave REMOTE_AGENT_URL empty to show this Raspberry Pi's real stats.
# No Ubuntu Server or token is required.
#
# Monitoring Method 2: SERVER MODE
# Run agent.py on a trusted Ubuntu Server and set BOTH fields below:
# REMOTE_AGENT_URL=http://YOUR_UBUNTU_SERVER_LAN_IP:8766
# REMOTE_AGENT_TOKEN=PASTE_THE_MATCHING_AGENT_TOKEN
# A non-empty REMOTE_AGENT_URL enables Server Mode.
SERVER_NAME="Home Server"
REMOTE_AGENT_URL=
REMOTE_AGENT_TOKEN=

# Both monitoring modes use the same display settings.
REFRESH_SECONDS=5
ROTATE_SECONDS=12

# Optional TCP reachability checks, used in either mode.
SERVICES_JSON='[]'

# Configure these only in the remote server's .env when running agent.py:
# AGENT_TOKEN=replace-with-a-long-random-token
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8766
