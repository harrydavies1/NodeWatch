[Unit]
Description=Raspberry Pi Server Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/pi-server-dashboard
ExecStart=/home/YOUR_USERNAME/pi-server-dashboard/.venv/bin/python /home/YOUR_USERNAME/pi-server-dashboard/dashboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
